        export function startApp() {

            // An input field stores the text entered into it in its value property. 
            // We can read that value after the user clicks a button.

            const workingText = document.createElement("p");
            workingText.textContent = "On a cold dark night,";
            document.body.append(workingText);
    
            const inputField = document.createElement("input");
            inputField.type = "text";
            document.body.append(inputField);

            const submitButton = document.createElement("button");
            submitButton.textContent = "Submit";
            document.body.append(submitButton);

            submitButton.onclick = () => {
                const userInput = inputField.value;  // inputFields use .value, not .textContent
                const userInputPlusLeadingSpace = " " + userInput;
                workingText.textContent = workingText.textContent + userInputPlusLeadingSpace;
                inputField.value = "";  // remove old text
